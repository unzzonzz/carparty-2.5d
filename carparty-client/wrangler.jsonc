{
  // Cloudflare Pages — 정적 사이트 배포 설정.
  //   수동 배포 : npx wrangler pages deploy
  //   자동 배포 : Cloudflare 대시보드에서 이 repo 를 연결하면 push 마다 빌드된다.
  //
  // 게임 서버(carparty-server)는 Cloudflare 에 올라가지 않는다 — WebSocket 을
  // 물고 60Hz 로 도는 Node 프로세스라 Workers 모델과 맞지 않는다. 자세한 내용은
  // README 의 "Cloudflare 배포" 절 참고.
  //
  // ★ VITE_WS_URL 은 넣지 않는다.
  //   클라이언트는 언제나 같은 오리진의 /ws 로 붙고, 그 /ws 를 실제 게임 서버로 넘기는
  //   일은 Pages Function(functions/ws.js)이 맡는다. VITE_WS_URL 을 넣으면 그 프록시를
  //   건너뛰고 지정한 주소로 직접 붙는다 — 프록시를 안 쓰는 호스팅(예: Render Static)에
  //   올릴 때만 쓰는 탈출구다.
  //   업스트림 게임 서버를 바꾸려면 GAME_SERVER_URL 환경변수를 쓴다.
  "name": "carparty-client",
  "compatibility_date": "2026-08-04",
  "pages_build_output_dir": "dist"
}
