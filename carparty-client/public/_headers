# Cloudflare Pages 응답 헤더 규칙.
# public/ 안에 두면 Vite 가 dist/ 로 그대로 복사하고 Pages 가 읽는다.
#
# 주의: 같은 헤더를 여러 규칙에서 지정하면 더 구체적인 쪽이 이긴다.
# 그래서 Cache-Control 은 경로별 규칙에만 두고 /* 에는 보안 헤더만 둔다.

# 해시가 붙은 Vite 산출물 — 내용이 바뀌면 파일명도 바뀌므로 영구 캐시해도 안전
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 서비스워커는 길게 캐시하면 새 배포가 영영 안 걸린다
/sw.js
  Cache-Control: no-cache

# 진입점 — 항상 재검증해야 새 assets 해시를 집어온다
/index.html
  Cache-Control: no-cache

# 게임 문서(셸의 iframe 안에서 열린다). 진입점과 같은 이유로 재검증.
# Pages 는 .html 을 떼고 /play 로 308 리다이렉트하므로 두 경로를 다 적어 둔다.
/play.html
  Cache-Control: no-cache

/play
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # 게임을 다른 사이트에 임베드할 여지를 남기되 타 출처 클릭재킹은 막는다.
  # 외부 포털(itch.io 등)에 넣을 계획이 생기면 이 줄과 CSP 의 frame-ancestors 를 함께 고친다.
  X-Frame-Options: SAMEORIGIN
  # 쓰지 않는 강력 권한은 아예 닫아 둔다 (프레임 안 게임 문서까지 함께 적용).
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), interest-cohort=()
  # CSP — 주입 스크립트 차단이 목적이다.
  #  · script-src 'self'  : 빌드 산출물만 실행. 콘솔/북마클릿으로 <script> 를 꽂아
  #    넣거나 외부 치트 스크립트를 불러오는 길이 막힌다. eval 도 함께 막힌다.
  #  · frame-ancestors 'self' : 타 출처 임베드 금지 (X-Frame-Options 의 현대판).
  #  · frame-src 'self'   : 셸이 띄우는 /play.html 만 허용.
  #  · style-src 'unsafe-inline' : 엔진이 요소 style 속성을 직접 만진다 (60Hz HUD).
  #  · connect-src ws:/wss: : 게임 서버 소켓. 기본은 같은 오리진의 /ws 지만
  #    VITE_WS_URL 로 다른 호스트를 가리키는 배포도 있어 스킴만 제한한다.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ws: wss:; worker-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'
